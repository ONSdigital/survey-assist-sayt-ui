FLASK_SECRET_KEY=replace-with-a-long-random-secret
SERVICE_NAME='Survey Assist SAYT UI'
SURVEY_ASSIST_API_BASE_URL=https://your-gateway-host/v1/survey-assist
SA_EMAIL=survey-assist-sayt-ui@your-project.iam.gserviceaccount.com
AUTH_MODE=local
LOCAL_USERS_FILE=users.json
SESSION_COOKIE_SECURE=false
# Client sessions remain the default for local and existing deployments.
SESSION_BACKEND=client
# Authenticated sessions expire 15 days after successful login.
SESSION_LIFETIME_DAYS=15

# For a host-run UI with a separately running Redis instance:
# SESSION_BACKEND=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_MAX_CONNECTIONS=32
REDIS_PASSWORD=not-a-real-password
# REDIS_USE_TLS=false

# Cloud Run / Memorystore supplies these when TLS is enabled:
# REDIS_USE_TLS=true
# REDIS_CA_CERT_DATA=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

# Optional override. The bundled example_survey.json definition is used by default.
# SURVEY_DEFINITION_FILE=/app/config/survey.json

# For Cloud Run / GCS auth file mode:
# AUTH_MODE=gcs
# GCP_AUTH_BUCKET_NAME=your-auth-bucket
# GCP_AUTH_BLOB_NAME=users.json
# SESSION_COOKIE_SECURE=true

# E2E test configuration
# SAYT_E2E_BASE_URL=https://your-sandbox-ui-host
# SAYT_E2E_USERNAME=test@example.com
# SAYT_E2E_PASSWORD=replace-with-a-test-account-password